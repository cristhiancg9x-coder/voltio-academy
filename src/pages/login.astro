---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthComponent from '../components/ui/AuthComponent.jsx';
---

<BaseLayout title="Iniciar Sesión" description="Accede a tu cuenta de VoltioAcademy">
  
  <div class="min-h-screen flex items-center justify-center px-4 py-20 relative overflow-hidden">
    
    {/* Fondo decorativo diferente (Violeta) */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-volt-secondary/10 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="relative z-10 w-full">
        <AuthComponent view="sign_in" client:only="react" />
    </div>

  </div>

</BaseLayout>