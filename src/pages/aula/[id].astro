---
// src/pages/aula/[id].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoPlayer from '../../components/ui/VideoPlayer.jsx';

// YA NO NECESITAMOS getStaticPaths PORQUE ESTAMOS EN MODO SERVER (SSR)
// Astro generará la página al vuelo para cualquier ID.

import { supabase } from '../../lib/supabase';

const { id } = Astro.params;

// 1. Pedimos los datos del curso a Supabase
let curso = null;
try {
  const { data, error } = await supabase
    .from('courses')
    .select(`
      id,
      title,
      description,
      modules (
        id,
        title,
        order_index,
        lessons (
          id,
          title,
          video_id,
          duration,
          order_index
        )
      )
    `)
    .eq('id', id)
    .single();

  if (error) throw error;
  curso = data;

  // Ordenar módulos y lecciones manualmente por order_index
  if (curso && curso.modules) {
    curso.modules.sort((a, b) => a.order_index - b.order_index);
    curso.modules.forEach(mod => {
      if (mod.lessons) {
        mod.lessons.sort((a, b) => a.order_index - b.order_index);
      }
    });
  }

} catch (error) {
  console.error("Error conectando a Supabase:", error);
}

// 2. Si el curso no existe en la BD, mandamos a 404
if (!curso) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`Aula: ${curso.title}`} description="Zona de estudio">
  <div class="min-h-screen bg-[#0a0a0a]">
    
    {/* Pasamos los datos REALES de la base de datos al reproductor */}
    <VideoPlayer client:only="react" courseData={curso} courseId={id} />

  </div>
</BaseLayout>